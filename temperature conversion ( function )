#include <iostream>
#include <string>
using namespace std;

float conversion(float tempC){
	float tempF;
	tempF = (tempC * 9/5 ) + 32;
	
	return tempF;
}

int main(){
	cout<<"--:Celsius to Fahrenheit conversion:--"<<endl<<endl;
	
	float tempC;
	cout<<"Enter temp in Celsius: ";
	cin>>tempC;
	
	cout<<"Temperature in Fahrenheit is "<<conversion(tempC);
}
